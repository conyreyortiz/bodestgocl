<script>
// ── Estado global ──────────────────────────────────
let m2 = 20, curOpt = null;
let cL = 3.5, cA = 2.0, cH = 2.4;
let rotY = -0.65, rotX = 0.55, zoom = 1;
let drag = false, px = 0, py = 0;
let raf = null;

// ── Cálculo de dimensiones ─────────────────────────
function calcD(v) {
  const rA = Math.max(.5, Math.round(Math.sqrt(v / 2) * 10) / 10);
  const rL = Math.max(.5, Math.round(v / rA * 10) / 10);
  const sL = Math.max(.5, Math.round(Math.sqrt(v) * 10) / 10);
  const sA = Math.max(.5, Math.round(v / sL * 10) / 10);
  return { rect: { l: rL, a: rA }, sq: { l: sL, a: sA } };
}

// ── SVG Planta 2D ──────────────────────────────────
function drawSVG(id, largo, ancho, accent) {
  const svg = document.getElementById(id);
  if (!svg) return;
  svg.innerHTML = '';
  const VW = 260, VH = 185, pad = 32;
  const sc = Math.min((VW - pad * 2) / largo, (VH - pad * 2) / ancho);
  const rw = largo * sc, rh = ancho * sc;
  const ox = (VW - rw) / 2, oy = (VH - rh) / 2;
  const pr = 2 * (rw + rh);
  const ns = 'http://www.w3.org/2000/svg';
  const mk = (t, a) => { const e = document.createElementNS(ns, t); Object.entries(a).forEach(([k, v]) => e.setAttribute(k, v)); return e; };

  svg.appendChild(mk('rect', { x: ox, y: oy, width: rw, height: rh, fill: '#f5f5f2', rx: '2' }));
  const gg = mk('g', { opacity: '.25' });
  const gs = Math.max(sc, 13);
  for (let gx = ox; gx <= ox + rw; gx += gs) gg.appendChild(mk('line', { x1: gx, y1: oy, x2: gx, y2: oy + rh, stroke: '#999', 'stroke-width': '.4' }));
  for (let gy = oy; gy <= oy + rh; gy += gs) gg.appendChild(mk('line', { x1: ox, y1: gy, x2: ox + rw, y2: gy, stroke: '#999', 'stroke-width': '.4' }));
  svg.appendChild(gg);

  svg.appendChild(mk('rect', { x: ox, y: oy, width: rw, height: rh, fill: 'none', stroke: accent, 'stroke-width': '4', rx: '2', 'stroke-dasharray': pr, style: `animation:drawIn .7s ease forwards;stroke-dashoffset:${pr};--dash:${pr};opacity:0` }));
  const dw = Math.min(rw * .44, 36), dx = ox + rw / 2 - dw / 2, dy = oy + rh;
  svg.appendChild(mk('rect', { x: dx, y: dy - 2, width: dw, height: 6, fill: '#f5f5f2' }));
  svg.appendChild(mk('path', { d: `M${dx} ${dy} A${dw} ${dw} 0 0 1 ${dx + dw} ${dy}`, fill: accent + '22', stroke: accent, 'stroke-width': '1.2', 'stroke-dasharray': '2 2', style: `animation:drawIn .5s .5s ease forwards;stroke-dashoffset:200;--dash:200;opacity:0` }));
  svg.appendChild(mk('line', { x1: dx, y1: dy, x2: dx, y2: dy - dw, stroke: accent, 'stroke-width': '1.5', style: `animation:drawIn .4s .5s ease forwards;stroke-dashoffset:${dw};--dash:${dw};opacity:0` }));

  const dY = oy + rh + 16;
  svg.appendChild(mk('line', { x1: ox, y1: dY, x2: ox + rw, y2: dY, stroke: '#bbb', 'stroke-width': '.8', style: `animation:drawIn .4s .7s ease forwards;stroke-dashoffset:${rw};--dash:${rw};opacity:0` }));
  const lt = mk('text', { x: ox + rw / 2, y: dY + 10, 'text-anchor': 'middle', 'font-size': '9.5', fill: '#777', 'font-family': 'DM Sans,sans-serif', style: 'animation:fadeUp .3s .85s ease forwards;opacity:0' });
  lt.textContent = largo.toFixed(1) + ' m'; svg.appendChild(lt);

  const dX = ox + rw + 13;
  svg.appendChild(mk('line', { x1: dX, y1: oy, x2: dX, y2: oy + rh, stroke: '#bbb', 'stroke-width': '.8', style: `animation:drawIn .4s .75s ease forwards;stroke-dashoffset:${rh};--dash:${rh};opacity:0` }));
  const at = mk('text', { x: dX + 9, y: oy + rh / 2, 'text-anchor': 'middle', 'font-size': '9.5', fill: '#777', 'font-family': 'DM Sans,sans-serif', transform: `rotate(90,${dX + 9},${oy + rh / 2})`, style: 'animation:fadeUp .3s .9s ease forwards;opacity:0' });
  at.textContent = ancho.toFixed(1) + ' m'; svg.appendChild(at);

  const mt = mk('text', { x: ox + rw / 2, y: oy + rh / 2 - 5, 'text-anchor': 'middle', 'font-size': '12', fill: accent, 'font-weight': '600', 'font-family': 'Syne,sans-serif', style: 'animation:fadeUp .4s .8s ease forwards;opacity:0' });
  mt.textContent = m2 + ' m²'; svg.appendChild(mt);
  const st = mk('text', { x: ox + rw / 2, y: oy + rh / 2 + 10, 'text-anchor': 'middle', 'font-size': '9', fill: '#ccc', 'font-family': 'DM Sans,sans-serif', style: 'animation:fadeUp .4s .85s ease forwards;opacity:0' });
  st.textContent = largo.toFixed(1) + '×' + ancho.toFixed(1); svg.appendChild(st);
  const pt = mk('text', { x: dx + dw / 2, y: dy + 14, 'text-anchor': 'middle', 'font-size': '8.5', fill: '#aaa', 'font-family': 'DM Sans,sans-serif', style: 'animation:fadeUp .3s .95s ease forwards;opacity:0' });
  pt.textContent = '⬆ puerta'; svg.appendChild(pt);
}

function setBadges(id, l, a) {
  const el = document.getElementById('b' + id[0]);
  if (!el) return;
  el.innerHTML = `<span class="badge">Largo <span class="bval">${l.toFixed(1)} m</span></span><span class="badge">Ancho <span class="bval">${a.toFixed(1)} m</span></span><span class="badge">Perm. <span class="bval">${(2 * (l + a)).toFixed(1)} m</span></span>`;
}

function setTable(d) {
  const s = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  s('trl', d.rect.l.toFixed(1) + ' m'); s('tra', d.rect.a.toFixed(1) + ' m');
  s('trp', (2 * (d.rect.l + d.rect.a)).toFixed(1) + ' m'); s('trac', d.rect.a.toFixed(1) + ' m');
  s('tsl', d.sq.l.toFixed(1) + ' m'); s('tsa', d.sq.a.toFixed(1) + ' m');
  s('tsp', (2 * (d.sq.l + d.sq.a)).toFixed(1) + ' m'); s('tsac', d.sq.a.toFixed(1) + ' m');
}

function render2D() {
  const d = calcD(m2);
  drawSVG('sr', d.rect.l, d.rect.a, '#2563eb');
  drawSVG('ss', d.sq.l, d.sq.a, '#059669');
  setBadges('rect', d.rect.l, d.rect.a);
  setBadges('sq', d.sq.l, d.sq.a);
  setTable(d);
}

// ── Selección de opción ────────────────────────────
function pick(opt) {
  curOpt = opt;
  document.getElementById('cr').classList.toggle('selected', opt === 'rect');
  document.getElementById('cs').classList.toggle('selected', opt === 'sq');
  const d = calcD(m2)[opt];
  cL = d.l; cA = d.a; cH = 2.4;
  const t3d = document.getElementById('t3d');
  const d3d = document.getElementById('d3d');
  if (t3d) t3d.textContent = 'Vista 3D — ' + (opt === 'rect' ? 'Rectangular' : 'Cuadrada');
  if (d3d) d3d.textContent = `${cL.toFixed(1)} m largo × ${cA.toFixed(1)} m ancho × ${cH} m alto`;
  const sec = document.getElementById('sec3d');
  sec.classList.add('on');
  setTimeout(() => sec.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
  setV('iso');
  startRender('c3d');
}

function close3d() {
  document.getElementById('sec3d').classList.remove('on');
  if (raf) { cancelAnimationFrame(raf); raf = null; }
  curOpt = null;
  document.getElementById('cr').classList.remove('selected');
  document.getElementById('cs').classList.remove('selected');
}

// ── Vistas ─────────────────────────────────────────
function setV(v) {
  if (v === 'inside') { rotY = Math.PI; rotX = 0.4; zoom = 1.2; }
  else if (v === 'front') { rotY = 0; rotX = 0.4; zoom = 1; }
  else if (v === 'iso') { rotY = -0.65; rotX = 0.55; zoom = 1; }
  else if (v === 'top') { rotY = -0.65; rotX = 1.45; zoom = 1.1; }
  draw3D('c3d');
}

// ── Motor 3D Canvas 2D ─────────────────────────────
function startRender(canvasId) {
  if (raf) { cancelAnimationFrame(raf); raf = null; }
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  canvas.width = canvas.offsetWidth || 700;
  canvas.height = 420;

  canvas.onmousedown = e => { drag = true; px = e.clientX; py = e.clientY; };
  canvas.onmouseup = canvas.onmouseleave = () => drag = false;
  canvas.onmousemove = e => {
    if (!drag) return;
    rotY += (e.clientX - px) * 0.012;
    rotX = Math.max(0.05, Math.min(1.5, rotX + (e.clientY - py) * 0.012));
    px = e.clientX; py = e.clientY;
    draw3D(canvasId);
  };
  canvas.onwheel = e => { zoom = Math.max(0.4, Math.min(3, zoom - e.deltaY * 0.001)); draw3D(canvasId); e.preventDefault(); };
  let lt = null;
  canvas.ontouchstart = e => { if (e.touches.length === 1) lt = { x: e.touches[0].clientX, y: e.touches[0].clientY }; };
  canvas.ontouchmove = e => {
    if (e.touches.length === 1 && lt) {
      rotY += (e.touches[0].clientX - lt.x) * 0.012;
      rotX = Math.max(0.05, Math.min(1.5, rotX + (e.touches[0].clientY - lt.y) * 0.012));
      lt = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      draw3D(canvasId);
    } e.preventDefault();
  };
  draw3D(canvasId);
  function loop() { raf = requestAnimationFrame(loop); }
  loop();
}

function draw3D(canvasId) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const W = canvas.width, H = canvas.height;
  if (!W || !H) return;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, W, H);

  const sky = ctx.createLinearGradient(0, 0, 0, H);
  sky.addColorStop(0, '#d8e4f0'); sky.addColorStop(1, '#edf1f5');
  ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);

  const l = cL, a = cA, h = cH;
  const base = Math.min(W, H);
  const sc = base / (Math.max(l, a, h) * 2.8) * zoom;
  const cx = W / 2, cy = H * 0.52;

  function proj(x, y, z) {
    const rx = x * Math.cos(rotY) - z * Math.sin(rotY);
    const rz = x * Math.sin(rotY) + z * Math.cos(rotY);
    const ry2 = y * Math.cos(rotX) - rz * Math.sin(rotX);
    return { x: cx + rx * sc, y: cy - ry2 * sc };
  }
  const V = (x, y, z) => proj(x, y, z);

  function face(pts, fill, stroke, lw) {
    ctx.beginPath();
    ctx.moveTo(pts[0].x, pts[0].y);
    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
    ctx.closePath();
    ctx.fillStyle = fill; ctx.fill();
    if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = lw || 1; ctx.stroke(); }
  }
  function quad(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3, fill, stroke, lw) {
    face([V(x0, y0, z0), V(x1, y1, z1), V(x2, y2, z2), V(x3, y3, z3)], fill, stroke, lw);
  }

  const hw = a / 2, hl = l / 2;

  // Grid suelo
  const gSize = Math.max(l, a) * 1.8, gStep = 1;
  ctx.save(); ctx.globalAlpha = 0.15;
  for (let gi = -gSize; gi <= gSize; gi += gStep) {
    const p1 = proj(gi, 0, -gSize), p2 = proj(gi, 0, gSize);
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
    ctx.strokeStyle = '#4466aa'; ctx.lineWidth = .5; ctx.stroke();
  }
  for (let gj = -gSize; gj <= gSize; gj += gStep) {
    const p1 = proj(-gSize, 0, gj), p2 = proj(gSize, 0, gj);
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
  }
  ctx.restore();

  // Piso
  quad(-hw, 0, -hl, hw, 0, -hl, hw, 0, hl, -hw, 0, hl, '#c2c2be', '#aaa', .5);
  ctx.save(); ctx.globalAlpha = 0.22;
  for (let gi = Math.ceil(-hl); gi <= Math.floor(hl); gi++) {
    const p1 = proj(-hw, .01, gi), p2 = proj(hw, .01, gi);
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
    ctx.strokeStyle = '#888'; ctx.lineWidth = .6; ctx.stroke();
  }
  ctx.restore();

  // Pared trasera
  quad(-hw, 0, -hl, hw, 0, -hl, hw, h, -hl, -hw, h, -hl, '#f0f0ed', '#ccc', .7);

  // Paredes laterales
  const showRight = Math.cos(rotY) > 0;
  if (!showRight) quad(-hw, 0, hl, -hw, 0, -hl, -hw, h, -hl, -hw, h, hl, '#e8e8e5', '#ccc', .7);
  if (showRight) quad(hw, 0, -hl, hw, 0, hl, hw, h, hl, hw, h, -hl, '#e2e2df', '#ccc', .7);

  // Pared frontal con hueco
  const dw = Math.min(a * 0.75, 1.0), dh = Math.min(h * 0.9, 2.0);
  quad(-hw, dh, hl, hw, dh, hl, hw, h, hl, -hw, h, hl, '#d5d5d2', '#bbb', .7);
  quad(-hw, 0, hl, -hw + (a - dw) / 2, 0, hl, -hw + (a - dw) / 2, dh, hl, -hw, dh, hl, '#d5d5d2', '#bbb', .7);
  quad(hw - (a - dw) / 2, 0, hl, hw, 0, hl, hw, dh, hl, hw - (a - dw) / 2, dh, hl, '#d5d5d2', '#bbb', .7);
  face([V(-dw / 2, 0, hl), V(dw / 2, 0, hl), V(dw / 2, dh, hl), V(-dw / 2, dh, hl)], '#b8b5b0', '#aaa', .5);

  // Techo
  if (rotX < 1.4) {
    quad(-hw, h, -hl, hw, h, -hl, hw, h, hl, -hw, h, hl, '#d0d0d3', '#bbb', .7);
    ctx.save(); ctx.globalAlpha = 0.45;
    const nv = Math.max(1, Math.round(l / 1.2));
    for (let i = 0; i <= nv; i++) {
      const zv = -hl + i * (l / nv);
      face([V(-hw, h - .05, zv - .05), V(hw, h - .05, zv - .05), V(hw, h, zv - .05), V(-hw, h, zv - .05)], '#bebebb', null);
    }
    ctx.restore();
  }

  // Foco
  const bp = proj(0, h - 0.12, 0);
  const grad = ctx.createRadialGradient(bp.x, bp.y, 0, bp.x, bp.y, sc * .45);
  grad.addColorStop(0, 'rgba(255,255,200,0.4)'); grad.addColorStop(1, 'rgba(255,255,200,0)');
  ctx.beginPath(); ctx.arc(bp.x, bp.y, sc * .45, 0, Math.PI * 2);
  ctx.fillStyle = grad; ctx.fill();
  ctx.beginPath(); ctx.arc(bp.x, bp.y, sc * .055, 0, Math.PI * 2);
  ctx.fillStyle = '#ffffcc'; ctx.fill();
  const cp = proj(0, h, 0);
  ctx.beginPath(); ctx.moveTo(cp.x, cp.y); ctx.lineTo(bp.x, bp.y);
  ctx.strokeStyle = '#888'; ctx.lineWidth = 1; ctx.stroke();

  // Número bodega
  const np = proj(dw * 0.2, dh * 0.88, hl + .01);
  ctx.fillStyle = 'rgba(255,255,255,0.95)';
  ctx.fillRect(np.x - sc * .12, np.y - sc * .07, sc * .24, sc * .14);
  ctx.strokeStyle = '#aaa'; ctx.lineWidth = .6;
  ctx.strokeRect(np.x - sc * .12, np.y - sc * .07, sc * .24, sc * .14);
  ctx.fillStyle = '#444'; ctx.font = `bold ${Math.max(8, sc * .09)}px Syne,sans-serif`;
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText('117', np.x, np.y);

  // Cotas
  ctx.save(); ctx.globalAlpha = 0.65;
  ctx.font = `${Math.max(9, sc * .085)}px DM Sans,sans-serif`;
  ctx.fillStyle = '#223355'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  const pL1 = proj(-hw - .25, .2, -hl), pL2 = proj(-hw - .25, .2, hl);
  ctx.beginPath(); ctx.moveTo(pL1.x, pL1.y); ctx.lineTo(pL2.x, pL2.y);
  ctx.strokeStyle = '#8899bb'; ctx.lineWidth = .8; ctx.stroke();
  const pm = proj(-hw - .25, .2, 0); ctx.fillText(l.toFixed(1) + ' m', pm.x - 10, pm.y);
  const pA1 = proj(-hw, .2, -hl - .25), pA2 = proj(hw, .2, -hl - .25);
  ctx.beginPath(); ctx.moveTo(pA1.x, pA1.y); ctx.lineTo(pA2.x, pA2.y); ctx.stroke();
  const pa = proj(0, .2, -hl - .25); ctx.fillText(a.toFixed(1) + ' m', pa.x, pa.y - 9);
  const pH1 = proj(hw + .18, 0, -hl), pH2 = proj(hw + .18, h, -hl);
  ctx.beginPath(); ctx.moveTo(pH1.x, pH1.y); ctx.lineTo(pH2.x, pH2.y); ctx.stroke();
  const ph = proj(hw + .18, h / 2, -hl); ctx.fillText(h.toFixed(1) + ' m', ph.x + 14, ph.y);
  ctx.restore();
}

// ── Hero canvas (auto-rotate) ─────────────────────
function initHeroCanvas() {
  const canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  canvas.width = canvas.offsetWidth || 500;
  canvas.height = canvas.offsetHeight || 375;
  cL = 4; cA = 2.5; cH = 2.4;
  let autoRot = -0.65;
  function heroLoop() {
    autoRot += 0.004;
    rotY = autoRot; rotX = 0.55; zoom = 0.95;
    draw3D('hero-canvas');
    requestAnimationFrame(heroLoop);
  }
  heroLoop();
}

// ── Inputs ────────────────────────────────────────
function onM2() {
  const v = parseFloat(document.getElementById('inp').value);
  if (!isNaN(v) && v > 0 && v <= 500) {
    m2 = v;
    document.getElementById('slr').value = Math.min(200, m2);
    document.getElementById('lbl').textContent = m2 + ' m²';
    render2D();
    if (curOpt) pick(curOpt);
  }
}
function onSlider() {
  m2 = parseFloat(document.getElementById('slr').value);
  document.getElementById('inp').value = m2;
  document.getElementById('lbl').textContent = m2 + ' m²';
  render2D();
  if (curOpt) pick(curOpt);
}

// ── Init ──────────────────────────────────────────
window.addEventListener('load', () => {
  render2D();
  initHeroCanvas();
});
</script>
