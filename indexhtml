<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Compra, Venta y Arriendo — Bodegas y Estacionamientos en LATAM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f4f3f0;
  --surface: #ffffff;
  --surface2: #f0eeeb;
  --border: #dddbd7;
  --text: #1a1917;
  --text2: #6b6860;
  --text3: #9c9a96;
  --accent: #2563eb;
  --accent2: #1d4ed8;
  --green: #059669;
  --radius: 14px;
  --shadow: 0 2px 12px rgba(0,0,0,.06), 0 1px 3px rgba(0,0,0,.04);
  --shadow-lg: 0 8px 32px rgba(0,0,0,.10), 0 2px 8px rgba(0,0,0,.06);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ── HEADER ── */
header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(244,243,240,.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0 40px;
  display: flex; align-items: center; justify-content: space-between;
  height: 68px;
}

.logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800; font-size: 18px;
  letter-spacing: -.5px; color: var(--text);
  display: flex; align-items: center; gap: 8px;
}
.logo-icon {
  width: 28px; height: 28px; background: var(--text);
  border-radius: 6px; display: flex; align-items: center; justify-content: center;
}
.logo-icon svg { width: 16px; height: 16px; fill: var(--bg); }

nav { display: flex; gap: 32px; }
nav a {
  font-size: 13px; font-weight: 500; color: var(--text2);
  text-decoration: none; transition: color .2s;
}
nav a:hover { color: var(--text); }

.cta-nav {
  background: var(--text); color: var(--bg) !important;
  padding: 8px 18px; border-radius: 8px;
  font-weight: 500 !important;
}
.cta-nav:hover { background: #333 !important; color: var(--bg) !important; }

/* ── HERO ── */
.hero {
  padding: 80px 40px 60px;
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 60px;
  align-items: center;
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: #dbeafe; color: #1e40af;
  font-size: 11px; font-weight: 500;
  padding: 4px 12px; border-radius: 20px;
  margin-bottom: 20px;
  letter-spacing: .3px;
}
.hero-badge::before { content:''; width:6px;height:6px;background:#3b82f6;border-radius:50%; }

.hero h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(36px, 5vw, 54px);
  font-weight: 800; line-height: 1.08;
  letter-spacing: -1.5px; color: var(--text);
  margin-bottom: 20px;
}
.hero h1 span { color: var(--accent); }

.hero p {
  font-size: 16px; line-height: 1.65;
  color: var(--text2); margin-bottom: 32px;
  max-width: 440px;
}

.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.btn-primary {
  background: var(--text); color: var(--bg);
  border: none; border-radius: 10px;
  padding: 14px 28px; font-size: 14px; font-weight: 500;
  cursor: pointer; font-family: 'DM Sans', sans-serif;
  transition: background .2s, transform .15s;
  text-decoration: none; display: inline-block;
}
.btn-primary:hover { background: #333; transform: translateY(-1px); }

.btn-secondary {
  background: transparent; color: var(--text);
  border: 1.5px solid var(--border); border-radius: 10px;
  padding: 13px 24px; font-size: 14px; font-weight: 500;
  cursor: pointer; font-family: 'DM Sans', sans-serif;
  transition: all .2s; text-decoration: none; display: inline-block;
}
.btn-secondary:hover { border-color: var(--text); }

.hero-stats {
  display: flex; gap: 28px; margin-top: 40px;
  padding-top: 32px; border-top: 1px solid var(--border);
}
.stat { }
.stat-num { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 700; color: var(--text); }
.stat-label { font-size: 11px; color: var(--text3); margin-top: 2px; }

.hero-visual {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  aspect-ratio: 4/3;
  position: relative;
}
.hero-canvas { width: 100%; height: 100%; display: block; }

/* ── SECTION ── */
section { padding: 80px 40px; }
section.alt { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

.section-label {
  font-size: 11px; font-weight: 500; color: var(--accent);
  text-transform: uppercase; letter-spacing: 1.5px;
  margin-bottom: 12px;
}
.section-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 700; letter-spacing: -1px; color: var(--text);
  margin-bottom: 12px;
}
.section-sub {
  font-size: 15px; color: var(--text2); line-height: 1.6;
  max-width: 520px;
}

.container { max-width: 1100px; margin: 0 auto; }

/* ── GENERADOR ── */
#generador { background: var(--bg); }

.gen-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  margin-top: 40px;
}

/* Top bar */
.gen-topbar {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--surface2);
}
.gen-topbar-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 14px; }
.gen-topbar-sub { font-size: 11px; color: var(--text3); }

/* m2 input */
.m2-bar {
  display: flex; align-items: center; gap: 14px;
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
}
.m2-label { font-size: 12px; color: var(--text2); white-space: nowrap; font-weight: 500; }
.m2-input {
  width: 82px; font-size: 22px; font-weight: 600;
  padding: 4px 8px; text-align: center;
  border: 1.5px solid var(--border); border-radius: 8px;
  font-family: 'Syne', sans-serif; color: var(--text);
  background: var(--surface);
  transition: border-color .2s;
}
.m2-input:focus { outline: none; border-color: var(--accent); }
.m2-unit { font-size: 16px; color: var(--text3); font-weight: 500; }
.m2-slider { flex: 1; accent-color: var(--accent); cursor: pointer; }
.m2-val { font-size: 12px; color: var(--text3); min-width: 46px; text-align: right; }

/* cards */
.cards-row {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16px; padding: 20px;
}

.opt-card {
  border: 1.5px solid var(--border);
  border-radius: var(--radius); background: var(--surface2);
  cursor: pointer; transition: all .2s;
  overflow: hidden; position: relative;
}
.opt-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
.opt-card.selected { border-color: var(--accent); border-width: 2px; box-shadow: 0 0 0 3px rgba(37,99,235,.12); }

.card-hdr { padding: 10px 14px 7px; border-bottom: 1px solid var(--border); background: var(--surface); }
.card-hdr-row { display: flex; justify-content: space-between; align-items: center; }
.card-name { font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; color: var(--text); }
.card-tag { font-size: 10px; padding: 2px 8px; border-radius: 20px; font-weight: 500; }
.card-desc { font-size: 10px; color: var(--text3); margin-top: 2px; }
.card-body { padding: 12px 10px 28px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.card-hint { position: absolute; bottom: 8px; right: 10px; font-size: 9px; color: var(--accent); opacity: .8; }

.badge { display: inline-flex; align-items: center; gap: 3px; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 2px 9px; font-size: 10px; color: var(--text2); }
.bval { font-weight: 600; color: var(--text); font-size: 11px; }

/* comparativa */
.cmp-table { padding: 0 20px 20px; }
.cmp-inner { background: var(--surface2); border-radius: 10px; border: 1px solid var(--border); padding: 14px 16px; }
.cmp-title { font-size: 10px; font-weight: 500; color: var(--text3); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 10px; }
.cmp-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; }
.cmp-head { font-size: 10px; font-weight: 600; padding: 3px 8px; border-bottom: 1px solid var(--border); text-align: center; }
.cmp-cell { font-size: 11px; font-weight: 500; padding: 5px 8px; text-align: center; color: var(--text); }
.cmp-row-label { font-size: 10px; color: var(--text3); padding: 5px 0; }

/* vista 3D inline */
#sec3d {
  display: none; margin: 0 20px 20px;
  border-radius: var(--radius); overflow: hidden;
  border: 2px solid var(--accent);
  box-shadow: var(--shadow);
  animation: slideIn .3s ease;
}
#sec3d.on { display: block; }
@keyframes slideIn { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:translateY(0)} }

.v3d-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 16px; background: var(--surface2);
  border-bottom: 1px solid var(--border);
}
.v3d-title { font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; color: var(--text); }
.v3d-sub { font-size: 10px; color: var(--text3); margin-top: 1px; }
.close-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text3); padding: 2px 6px; line-height: 1; }
.close-btn:hover { color: var(--text); }

#c3d { display: block; width: 100%; height: 420px; background: #edf1f5; }

.v3d-foot {
  display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
  padding: 10px 16px; background: var(--surface2);
  border-top: 1px solid var(--border);
}
.v3d-dims { font-size: 11px; color: var(--text3); flex: 1; }
.vbtn {
  font-size: 11px; padding: 5px 12px; cursor: pointer;
  border-radius: 6px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text2);
  font-family: 'DM Sans', sans-serif;
  transition: all .15s;
}
.vbtn:hover { background: var(--surface2); border-color: var(--text2); }

/* ── FEATURES ── */
.features-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 24px; margin-top: 48px;
}
.feat-card {
  background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 28px 24px;
  transition: box-shadow .2s;
}
.feat-card:hover { box-shadow: var(--shadow); }
.feat-icon {
  width: 44px; height: 44px; background: var(--text);
  border-radius: 10px; display: flex; align-items: center; justify-content: center;
  margin-bottom: 16px;
}
.feat-icon svg { width: 22px; height: 22px; stroke: var(--bg); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.feat-title { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; margin-bottom: 8px; }
.feat-desc { font-size: 13px; color: var(--text2); line-height: 1.6; }

/* ── HOW IT WORKS ── */
.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 48px; }
.step { text-align: center; }
.step-num {
  width: 48px; height: 48px;
  background: var(--text); color: var(--bg);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700;
  margin: 0 auto 16px;
}
.step-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; margin-bottom: 6px; }
.step-desc { font-size: 12px; color: var(--text2); line-height: 1.55; }

/* ── CTA ── */
.cta-section {
  background: var(--text); padding: 80px 40px;
  text-align: center;
}
.cta-section h2 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 800; color: var(--bg);
  letter-spacing: -1px; margin-bottom: 16px;
}
.cta-section p { font-size: 15px; color: #9ca3af; margin-bottom: 32px; }
.btn-white {
  background: var(--bg); color: var(--text);
  border: none; border-radius: 10px;
  padding: 14px 32px; font-size: 14px; font-weight: 600;
  cursor: pointer; font-family: 'DM Sans', sans-serif;
  transition: all .2s; text-decoration: none; display: inline-block;
}
.btn-white:hover { background: #e5e4e1; transform: translateY(-1px); }

/* ── FOOTER ── */
footer {
  padding: 32px 40px;
  border-top: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.footer-copy { font-size: 12px; color: var(--text3); }
.footer-links { display: flex; gap: 20px; }
.footer-links a { font-size: 12px; color: var(--text3); text-decoration: none; }
.footer-links a:hover { color: var(--text); }

/* ── SVG animaciones ── */
@keyframes drawIn { from{stroke-dashoffset:var(--dash);opacity:0} to{stroke-dashoffset:0;opacity:1} }
@keyframes fadeUp { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  header { padding: 0 20px; }
  nav { display: none; }
  .hero { grid-template-columns: 1fr; gap: 32px; padding: 48px 20px 40px; }
  .hero-visual { display: none; }
  section { padding: 60px 20px; }
  .features-grid { grid-template-columns: 1fr; }
  .steps { grid-template-columns: 1fr 1fr; gap: 24px; }
  .cards-row { grid-template-columns: 1fr; }
  .m2-bar { flex-wrap: wrap; gap: 10px; }
  .cta-section { padding: 60px 20px; }
  footer { flex-direction: column; gap: 16px; text-align: center; }
}
</style>
</head>
